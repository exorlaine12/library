@model MemberDetails
@{
    ViewData["Title"] = Model.Member.FullName;
    int totalLoans = Model.Loans.Count;
    int booksOut = Model.Loans.Count(l => l.ReturnedOn == null);
}

<div class="mb-3">
    <h1 class="mb-1">@Model.Member.FullName</h1>
    <p class="text-muted mb-0">
        <span class="pill pill-type">@Model.Member.MemberType</span>
        &nbsp;@(Model.Member.Email ?? "no email")
    </p>
</div>

<div class="stat-row" style="max-width:26rem">
    <div class="stat-card stat-total">
        <div class="stat-num">@totalLoans</div>
        <div class="stat-label">Loans in total</div>
    </div>
    <div class="stat-card stat-out">
        <div class="stat-num">@booksOut</div>
        <div class="stat-label">Books out now</div>
    </div>
</div>

<h2 class="h5 mt-4">Loans</h2>
@if (Model.Loans.Count == 0)
{
    <p>This member has never borrowed a book.</p>
}
else
{
    <div class="card-table">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Book</th>
                    <th>Loaned</th>
                    <th>Returned</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model.Loans)
                {
                    <tr>
                        <td>@loan.BookTitle</td>
                        <td>@(loan.LoanedOn.ToString("yyyy-MM-dd"))</td>
                        <td>@(loan.ReturnedOn?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td><span class="pill pill-@loan.Status.ToLower()">@loan.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="Index" class="btn btn-link px-0">Back to members</a>