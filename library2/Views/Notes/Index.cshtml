@model List<Note>

@{
    ViewData["Title"] = "Notepad";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Notepad</h1>
            <p class="text-muted">Manage your library notes.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Note
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No notes found. Click Add Note to create your first note.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Body</th>
                        <th>Created On</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var note in Model)
                    {
                        <tr>
                            <td>@note.NoteId</td>
                            <td>@note.Title</td>
                            <td>@(note.Body ?? "No body")</td>
                            <td>@note.CreatedOn.ToString("yyyy-MM-dd")</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@note.NoteId"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@note.NoteId"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
