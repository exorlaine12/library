
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - LibraryHub</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/library2.styles.css"
          asp-append-version="true" />
</head>

<body>
    <!-- Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark library-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">L</span>

                    <span>
                        <span class="brand-name">LibraryHub</span>
                        <small class="brand-subtitle d-block">
                            MANAGEMENT SYSTEM
                        </small>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Books"
                               asp-action="Index">
                                Books
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Members"
                               asp-action="Index">
                                Members
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-library"
                               asp-controller="Books"
                               asp-action="Index">
                                Explore Library
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Notes"
                               asp-action="Index">
                                Notepad
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="main-content">
        <div class="container page-container">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="library-footer">
        <div class="container">
            <div class="row align-items-center gy-3">

                <div class="col-md-6">
                    <a class="footer-brand"
                       asp-controller="Home"
                       asp-action="Index">
                        LibraryHub
                    </a>

                    <p class="footer-description mb-0">
                        A simple and organized way to manage your library.
                    </p>
                </div>

                <div class="col-md-6 text-md-end">
                    <a class="footer-link"
                       asp-controller="Home"
                       asp-action="Privacy">
                        Privacy Policy
                    </a>

                    <p class="footer-copyright mb-0 mt-2">
                        &copy; @DateTime.Now.Year LibraryHub.
                        All rights reserved.
                    </p>
                </div>

            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

