

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - LibraryHub</title>

    <script type="importmap"></script>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Main Website CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Additional Project CSS -->
    <link rel="stylesheet"
          href="~/library2.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- =====================================
         NAVIGATION BAR
    ====================================== -->

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark library-navbar">

            <div class="container">

                <!-- BRAND -->
                <a class="navbar-brand d-flex align-items-center gap-2"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">L</span>

                    <span>
                        <span class="brand-name">LibraryHub</span>

                        <small class="brand-subtitle d-block">
                            MANAGEMENT SYSTEM
                        </small>
                    </span>

                </a>

                <!-- MOBILE MENU BUTTON -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- NAVIGATION LINKS -->
                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                        <!-- HOME -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <span class="nav-label">Home</span>

                            </a>
                        </li>

                        <!-- BOOKS -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Books"
                               asp-action="Index">

                                <span class="nav-label">Books</span>

                            </a>
                        </li>

                        <!-- MEMBERS -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Members"
                               asp-action="Index">

                                <span class="nav-label">Members</span>

                            </a>
                        </li>

                        <!-- LOANS -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Loans"
                               asp-action="Index">

                                <span class="nav-label">Loans</span>

                            </a>
                        </li>

                        <!-- NOTEPAD -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Notes"
                               asp-action="Index">

                                <span class="nav-label">Notepad</span>

                            </a>
                        </li>

                        <!-- PRIVACY -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">

                                <span class="nav-label">Privacy</span>

                            </a>
                        </li>

                        <!-- EXPLORE LIBRARY BUTTON -->
                        <li class="nav-item ms-lg-2">

                            <a class="btn btn-library"
                               asp-controller="Books"
                               asp-action="Index">

                                Explore Library

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>
    </header>


    <!-- =====================================
         MAIN CONTENT
    ====================================== -->

    <main class="main-content">

        <div class="container page-container">

            @RenderBody()

        </div>

    </main>


    <!-- =====================================
         FOOTER
    ====================================== -->

    <footer class="library-footer">

        <div class="container">

            <div class="row align-items-center gy-4">

                <!-- FOOTER BRAND -->
                <div class="col-md-6">

                    <a class="footer-brand"
                       asp-controller="Home"
                       asp-action="Index">

                        LibraryHub

                    </a>

                    <p class="footer-description mb-0">

                        A simple and organized way to manage
                        your library resources and records.

                    </p>

                </div>


                <!-- FOOTER LINKS -->
                <div class="col-md-6 text-md-end">

                    <a class="footer-link"
                       asp-controller="Home"
                       asp-action="Privacy">

                        Privacy Policy

                    </a>

                    <p class="footer-copyright mb-0 mt-2">

                        &copy; @DateTime.Now.Year LibraryHub.
                        All rights reserved.

                    </p>

                </div>

            </div>

        </div>

    </footer>


    <!-- =====================================
         JAVASCRIPT
    ====================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
