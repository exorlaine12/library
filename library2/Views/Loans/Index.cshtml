@using System.Linq
@model List<library2.Models.LoanView>
@{
    ViewData["Title"] = "Loans";

    int outCount = Model.Count(l => l.Status == "Out");
    int overdueCount = Model.Count(l => l.Status == "Overdue");
    int returnedCount = Model.Count(l => l.Status == "Returned");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Loans</h1>
        <p class="text-muted mb-0">@Model.Count loans, newest first</p>
    </div>
    <a asp-action="Borrow" class="btn btn-primary">+ Borrow a book</a>
</div>

@* Loan statistics *@
<div class="stat-row">
    <div class="stat-card stat-out">
        <div class="stat-num">@outCount</div>
        <div class="stat-label">Out</div>
    </div>
    <div class="stat-card stat-overdue">
        <div class="stat-num">@overdueCount</div>
        <div class="stat-label">Overdue</div>
    </div>
    <div class="stat-card stat-returned">
        <div class="stat-num">@returnedCount</div>
        <div class="stat-label">Returned</div>
    </div>
</div>

@* Loans table *@
<div class="card-table">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Member</th>
                <th>Book</th>
                <th>Loaned</th>
                <th>Due</th>
                <th>Status</th>
                <th style="width: 7rem"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No loan records found.</td>
                </tr>
            }
            else
            {
                foreach (var loan in Model)
                {
                    <tr>
                        <td>
                            <a asp-controller="Members" asp-action="Details" asp-route-id="@loan.MemberId">@loan.MemberName</a>
                        </td>
                        <td>@loan.BookTitle</td>
                        <td>@(loan.LoanedOn.ToString("yyyy-MM-dd"))</td>
                        <td>@(loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd"))</td>
                        <td>
                            <span class="pill pill-@(loan.Status.ToLowerInvariant())">@loan.Status</span>
                        </td>
                        <td class="text-end">
                            @if (loan.ReturnedOn == null)
                            {
                                <form asp-action="Return" asp-route-id="@loan.LoanId" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-success">&#8617; Return</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>