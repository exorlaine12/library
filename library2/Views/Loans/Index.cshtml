@using System.Linq
@model List<library2.Models.LoanView>

@{
    ViewData["Title"] = "Loans";
    int outCount = Model.Count(l => l.Status == "Out");
    int overdueCount = Model.Count(l => l.Status == "Overdue");
    int returnedCount = Model.Count(l => l.Status == "Returned");
}

<!-- Page Heading -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Loans</h1>
        <p class="text-muted mb-0">
            @Model.Count loans, newest first
        </p>
    </div>
    <a asp-action="Borrow" class="btn btn-primary">
        + Borrow a book
    </a>
</div>

<!-- Success Message -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<!-- Error Message -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<!-- Loan Statistics -->
<div class="stat-row">

    <div class="stat-card stat-out">
        <div class="stat-num">@outCount</div>
        <div class="stat-label">Out</div>
    </div>
    <div class="stat-card stat-overdue">
        <div class="stat-num">@overdueCount</div>
        <div class="stat-label">Overdue</div>
    </div>
    <div class="stat-card stat-returned">
        <div class="stat-num">@returnedCount</div>
        <div class="stat-label">Returned</div>
    </div>
    <div class="stat-card stat-total">
        <div class="stat-num">@Model.Count</div>
        <div class="stat-label">Total Loans</div>
    </div>
</div>

<!-- Loans Table -->
<div class="card-table">
    <div class="table-responsive">
        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>Member</th>
                    <th>Book</th>
                    <th>Loaned</th>
                    <th>Due</th>
                    <th>Status</th>
                    <th class="text-end" style="width: 8rem;">
                        Action
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No loan records found.
                            Start by borrowing a book.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var loan in Model)
                    {
                        <tr>
                            <!-- Member Name -->
                            <td>
                                <a asp-controller="Members"
                                   asp-action="Details"
                                   asp-route-id="@loan.MemberId"
                                   class="fw-semibold">
                                    @loan.MemberName
                                </a>
                            </td>
                            <!-- Book Title -->
                            <td>
                                @loan.BookTitle
                            </td>
                            <!-- Loan Date -->
                            <td>
                                @loan.LoanedOn.ToString("yyyy-MM-dd")
                            </td>
                            <!-- Due Date -->
                            <td>
                                @loan.LoanedOn.AddDays(loan.DaysAllowed)
                                .ToString("yyyy-MM-dd")
                            </td>

                            <!-- Loan Status -->
                            <td>
                                <span class="pill pill-@loan.Status.ToLowerInvariant()">
                                    @loan.Status
                                </span>
                            </td>

                            <!-- Return Button -->
                            <td class="text-end">

                                @if (loan.ReturnedOn == null)
                                {
                                    <form asp-action="Return"
                                          asp-route-id="@loan.LoanId"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success"
                                                onclick="return confirm('Are you sure you want to return this book?');">
                                            ↩ Return
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        Completed
                                    </span>
                                }
                            </td>

                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
